<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      The shell is dark because the site paints a dark surface first and the
      configured Capacitor backgroundColor is the same #0B0F19. Matching them
      removes the white flash between the splash screen and the first remote
      frame.
    -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/brandSurface</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!--
      Android 12+ draws the splash from the theme itself. The icon is the brand
      mark on the brand surface, so the launch sequence is the product's, not a
      default grey square.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brandSurface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_brand_mark</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">@color/brandSurface</item>
    </style>
</resources>
