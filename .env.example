# Local SQLite file. For PostgreSQL, change `provider` in prisma/schema.prisma
# to "postgresql" and use e.g. postgresql://user:pass@localhost:5432/aiml
DATABASE_URL="file:./dev.db"

# Signing key for session cookies. MUST be set to a long random value in
# production — generate one with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-value"

# ─── Email (verification + password reset) ────────────────────────────────
# Transport: "console" prints the message to the server log (the default in
# development, and a working fallback anywhere), "resend" sends for real.
# Leave unset and it picks "resend" when RESEND_API_KEY is present.
EMAIL_TRANSPORT="console"

# API key from https://resend.com/api-keys. Required only for the "resend"
# transport. Never commit a real key — set it in the host's secret store.
RESEND_API_KEY=""

# From address for outgoing mail. Must be a verified sender at the provider.
EMAIL_FROM="AI/ML Mastery <onboarding@resend.dev>"

# Absolute base URL used to build links in emails. Read from configuration
# rather than the request Host header, so a spoofed Host cannot rewrite a
# verification or reset link to point at an attacker's domain.
# NEXT_PUBLIC_SITE_URL is accepted as a fallback for hosts that set it.
APP_URL="http://localhost:3000"

# Test-only transport. EMAIL_TRANSPORT=file appends each message as JSON to
# this path so an end-to-end run can read its own inbox. It writes live
# tokens to disk and is refused outright when NODE_ENV is production.
# EMAIL_OUTBOX_PATH="./playwright/.auth/outbox.jsonl"

# ─── AI answer evaluation (optional) ──────────────────────────────────────
# Without a key, written answers are still evaluated — deterministically,
# against the concepts the curriculum's reference answer relies on. The key
# turns on the semantic pass on top of that. Server-side only: there is no
# NEXT_PUBLIC_ counterpart and the module that reads it is `server-only`.
ANTHROPIC_API_KEY=""

# Overrides the evaluation model. Defaults to a small, fast one.
ANTHROPIC_MODEL=""
