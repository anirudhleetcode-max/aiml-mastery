{
  "name": "aiml-mastery",
  "version": "1.0.0",
  "private": true,
  "description": "AI/ML Mastery \u2014 a complete, adaptive learning platform covering 214 units from Python fundamentals to Generative AI and MLOps.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:prune": "tsx scripts/prune.ts",
    "db:reset": "rm -f prisma/dev.db && prisma db push && npm run db:seed",
    "setup": "prisma generate && prisma db push && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "curriculum:verify": "tsx scripts/verify-curriculum.ts",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "verify": "npm run typecheck && npm run lint && npm run check:contrast && npm run curriculum:verify && npm test",
    "perf": "node scripts/perf-audit.mjs",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.3.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "framer-motion": "^12.23.12",
    "jose": "^6.2.12",
    "katex": "^0.16.22",
    "lucide-react": "^0.545.0",
    "next": "15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.2.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "three": "^0.180.0",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/d3-force": "^3.0.10",
    "@types/katex": "^0.16.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "jsdom": "^26.1.0",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "deepmerge-ts": "^8.0.0"
  }
}
