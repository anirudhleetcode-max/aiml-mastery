<?xml version="1.0" encoding="utf-8"?>
<!--
  Shown when a main-frame load fails. Native rather than HTML, because the one
  thing that is certainly unavailable when a page fails to load is the page.

  The copy is deliberately honest about what this app is: a client for a
  server-backed platform. It does not promise cached lessons, because there are
  none — inventing an offline library would be a lie the learner discovers the
  moment they tap it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:clickable="true"
    android:focusable="true"
    android:background="@color/brandSurface"
    android:paddingStart="32dp"
    android:paddingEnd="32dp">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/ic_brand_mark"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/offline_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/offline_title"
        android:textColor="@color/brandInk"
        android:textSize="22sp"
        android:textStyle="bold"
        android:accessibilityHeading="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/offline_body"
        android:textColor="@color/brandInkMuted"
        android:textSize="15sp"
        android:lineSpacingExtra="4sp"
        android:gravity="center" />

    <Button
        android:id="@+id/offline_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:minWidth="160dp"
        android:minHeight="48dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:background="@drawable/bg_retry_button"
        android:text="@string/offline_retry"
        android:textColor="#0B0F19"
        android:textStyle="bold"
        android:textAllCaps="false" />
</LinearLayout>
