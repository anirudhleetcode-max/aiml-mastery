// AI/ML Mastery — persistence schema.
//
// Provider is SQLite so the app works immediately after `npm run setup` with
// no external service. Every model below is portable to PostgreSQL: switch
// `provider` to "postgresql", point DATABASE_URL at the server and run
// `prisma migrate dev`. No SQLite-specific types are used.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile           Profile?
  state             LearnerMeta?
  progress          UnitProgress[]
  assessments       Assessment[]
  xpTransactions    XpTransaction[]
  achievements      UserAchievement[]
  mistakes          Mistake[]
  notes             Note[]
  teachingAttempts  TeachingAttempt[]
  sessions          StudySession[]
  activity          DayActivity[]
  notifications     Notification[]
  appliedEvents     AppliedEvent[]
  authSessions      AuthSession[]
  flashcardReviews  FlashcardReview[]
  interviewAttempts InterviewAttempt[]
  answerEvaluations AnswerEvaluation[]
  labCompletions    LabCompletion[]
  authTokens        AuthToken[]
  /// Null until the address is confirmed. Gating on a timestamp rather than a
  /// boolean records *when*, which an audit needs and a flag cannot give.
  emailVerifiedAt   DateTime?
}

/// Server-side session records, so a token can be revoked rather than only expiring.
model AuthSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?

  @@index([userId])
}

model Profile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  studyBudget        Int       @default(60)
  preferredStudyTime String    @default("19:00")
  experience         String    @default("complete-beginner")
  targetRole         String    @default("ai-ml-intern")
  startDate          String    @default("2026-09-20")
  endDate            String    @default("2026-12-31")
  timezone           String    @default("UTC")
  onboardedAt        DateTime?
  /// JSON blob of NotificationPrefs.
  notificationPrefs  String    @default("{}")
  /// JSON array of paused ISO dates.
  pausedDates        String    @default("[]")
  theme              String    @default("dark")
  reduceMotion       Boolean   @default(false)
  highContrast       Boolean   @default(false)
  fontScale          Int       @default(100)
  updatedAt          DateTime  @updatedAt
}

/// Scalar learner state that does not belong to a per-unit or per-event row.
model LearnerMeta {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  xp                Int      @default(0)
  revision          Int      @default(0)
  streakCurrent     Int      @default(0)
  streakLongest     Int      @default(0)
  streakLastDate    String?
  testStreak        Int      @default(0)
  longestTestStreak Int      @default(0)
  teachingStreak    Int      @default(0)
  freezesRemaining  Int      @default(2)
  disciplineScore   Int      @default(80)
  testsDue          Int      @default(0)
  testsCompleted    Int      @default(0)
  testsMissed       Int      @default(0)
  updatedAt         DateTime @updatedAt
}

model UnitProgress {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId             String
  mastery            String    @default("NOT_STARTED")
  bestScore          Float     @default(0)
  lastScore          Float     @default(0)
  attempts           Int       @default(0)
  practiceCompleted  Int       @default(0)
  /// JSON array of completed practice indices, so the count cannot be inflated
  /// by repeating the same item.
  practiceDone       String    @default("[]")
  challengeCompleted Boolean   @default(false)
  teachingScore      Float?
  lessonCompletedAt  DateTime?
  lastStudiedAt      DateTime?
  timeSpentSeconds   Int       @default(0)
  nextReviewAt       String?
  reviewStep         Int       @default(0)
  weak               Boolean   @default(false)
  skipped            Boolean   @default(false)
  bookmarked         Boolean   @default(false)
  flaggedDifficult   Boolean   @default(false)
  updatedAt          DateTime  @updatedAt

  @@unique([userId, unitId])
  @@index([userId, nextReviewAt])
}

model Assessment {
  id          String   @id
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String
  date        String
  /// JSON array of unit ids covered.
  unitIds     String
  score       Float
  correct     Int
  total       Int
  seconds     Int
  completedAt DateTime @default(now())
  answers     Answer[]

  @@index([userId, date])
  @@index([userId, kind])
}

model Answer {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId   String
  unitId       String
  type         String
  correct      Boolean
  credit       Float      @default(0)
  /// JSON-encoded learner response.
  response     String
  seconds      Int        @default(0)

  @@index([assessmentId])
}

model XpTransaction {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String
  detail    String
  unitId    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  unlockedAt    DateTime @default(now())

  @@unique([userId, achievementId])
}

model Mistake {
  id            String   @id
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId        String
  questionId    String
  prompt        String
  yourAnswer    String
  correctAnswer String
  why           String
  concept       String
  createdAt     DateTime @default(now())
  reviewAt      String
  resolved      Boolean  @default(false)
  timesWrong    Int      @default(1)

  @@unique([userId, questionId])
  @@index([userId, resolved])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId    String
  body      String
  updatedAt DateTime @updatedAt

  @@unique([userId, unitId])
}

model TeachingAttempt {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId    String
  text      String
  score     Float
  clarity   Float    @default(0)
  /// JSON arrays.
  coverage  String   @default("[]")
  missing   String   @default("[]")
  feedback  String
  createdAt DateTime @default(now())

  @@index([userId, unitId])
}

model StudySession {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId    String?
  kind      String
  startedAt DateTime @default(now())
  seconds   Int

  @@index([userId, startedAt])
}

/// One row per calendar day, powering the heatmap and daily/weekly reports.
model DayActivity {
  id             String  @id @default(cuid())
  userId         String
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           String
  unitsCompleted Int     @default(0)
  xp             Int     @default(0)
  studySeconds   Int     @default(0)
  testScore      Float?
  testTaken      Boolean @default(false)
  teachBacks     Int     @default(0)

  @@unique([userId, date])
  @@index([userId, date])
}

model Notification {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String
  href      String?
  dedupeKey String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, read])
}

/// Idempotency ledger: a replayed offline event is applied exactly once.
model AppliedEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String
  type      String
  appliedAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([userId, appliedAt])
}

/// One row per flashcard the learner has actually graded.
///
/// Flashcards were previously reviewed entirely in component state, so the
/// session's verdict evaporated on navigation: nothing scheduled a card for
/// another pass and nothing could report how many had been reviewed. Cards are
/// addressed by (unitId, cardIndex) because a flashcard has no id of its own
/// in the curriculum schema, and the index is stable for a given unit.
model FlashcardReview {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId         String
  cardIndex      Int
  /// "known" or "again" — the learner's own verdict, which is the only signal
  /// a recall check can produce.
  lastGrade      String
  timesSeen      Int      @default(0)
  timesKnown     Int      @default(0)
  timesAgain     Int      @default(0)
  /// Rung on the REVIEW_STEPS ladder shared with unit review scheduling.
  reviewStep     Int      @default(0)
  nextReviewAt   String
  lastReviewedAt DateTime @default(now())

  @@unique([userId, unitId, cardIndex])
  @@index([userId, nextReviewAt])
}

/// One row per interview question the learner has attempted.
///
/// The curriculum carries 660 interview questions that were only ever rendered
/// inside their own lesson. This records an attempt so they can be practised
/// across units, weak areas can be found, and readiness can be computed from
/// evidence rather than asserted.
model InterviewAttempt {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId        String
  /// Index of the question within the unit's interviewQuestions array.
  questionIndex Int
  /// Self-assessed confidence after seeing the model answer: the honest signal
  /// available for an open-ended question with no machine-checkable answer.
  confidence    String
  /// Seconds spent before revealing the answer, which is itself diagnostic.
  seconds       Int      @default(0)
  attempts      Int      @default(1)
  lastAttemptAt DateTime @default(now())

  @@unique([userId, unitId, questionIndex])
  @@index([userId, confidence])
}

/// One row per lab a learner has worked through to its stated objective.
model LabCompletion {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  labId       String
  /// Checklist indices the learner has ticked, as JSON, so a count cannot be
  /// inflated by ticking the same step repeatedly.
  stepsDone   String    @default("[]")
  completedAt DateTime?
  seconds     Int       @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([userId, labId])
}

/// Fixed-window rate-limit counters.
///
/// Shared rather than in-process, because an in-memory Map gives every
/// instance its own budget: four instances behind a load balancer would allow
/// four times the intended limit, which is the control quietly not working
/// rather than the control failing loudly. One row per key, rewritten when its
/// window expires, so the table stays proportional to active clients.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  /// Epoch milliseconds at which the current window ends.
  resetAt   BigInt
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

/// Single-use, expiring tokens for email verification and password reset.
///
/// Only a SHA-256 hash of the token is stored. A database dump therefore
/// cannot be replayed against the endpoints, which is the same reasoning that
/// puts a bcrypt hash in `passwordHash` rather than the password. The raw
/// token exists only in the email link.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "email-verification" or "password-reset".
  purpose   String
  /// SHA-256 of the raw token, hex encoded. Unique so a lookup is a single
  /// indexed read and so two tokens can never collide.
  tokenHash String    @unique
  expiresAt DateTime
  /// Set the moment the token is spent, which is what makes it single-use.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

/// One stored evaluation of a typed answer, for an interview question or a
/// flashcard recall attempt.
///
/// Kept as one row per item rather than an append-only log: the learner wants
/// to see what the last attempt said, and an unbounded history of prose
/// answers is storage nobody reads. `attempts` preserves the fact that the
/// item was worked more than once, which is the part that carries meaning.
model AnswerEvaluation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "interview" or "flashcard" — which bank the index addresses.
  target    String
  unitId    String
  /// Index of the question or card within its unit.
  itemIndex Int
  /// The learner's own text, so the feedback can be read back beside it.
  answer    String
  /// The evaluation, serialised. Read back through storedEvaluationSchema
  /// rather than cast, because a row written by an older version of the
  /// evaluator is untrusted input like any other.
  result    String
  /// "deterministic" or "ai" — surfaced so a score is never anonymous.
  source    String
  /// Headline score, duplicated out of `result` so it is queryable.
  score     Int      @default(0)
  attempts  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, target, unitId, itemIndex])
  @@index([userId, target])
}
